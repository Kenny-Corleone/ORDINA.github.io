# Firebase Configuration
# These environment variables are optional. If not provided, the app will use the default Firebase project configuration.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
VITE_USE_FIREBASE_EMULATORS=false

# OpenWeatherMap API Key (optional)
# Get your free API key at: https://openweathermap.org/api
# If not provided, weather widget will show placeholder data
VITE_OPENWEATHER_API_KEY=your_api_key_here

# Finnhub API Key (for stocks)
# Get your free API key at: https://finnhub.io/
VITE_FINNHUB_API_KEY=your_api_key_here
VITE_ALPHA_VANTAGE_API_KEY=your_api_key_here
